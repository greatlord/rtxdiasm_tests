.version 6.0
.target sm_50
.address_size 64

.const .u32 table[4] = { 11, 22, 33, 44 };

.visible .entry k(.param .u64 out)
{
    .reg .b64 %rd<4>;
    .reg .b32 %r<4>;
    ld.param.u64 %rd0, [out];
    mov.u64 %rd1, table;
    add.u64 %rd1, %rd1, 4;
    ld.const.u32 %r0, [%rd1];
    st.global.u32 [%rd0], %r0;
    ret;
}
