.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u64 offset;
    .reg .u64 addr;
    .reg .u32 tid;
    .reg .v4 .u32 value;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    mov.u32 tid, %tid.x;
    mul.wide.u32 offset, tid, 16;
    add.u64 addr, in_addr, offset;
    ld.global.v4.u32 value, [addr];
    st.global.v4.u32 [out_addr], value;
    ret;
}
