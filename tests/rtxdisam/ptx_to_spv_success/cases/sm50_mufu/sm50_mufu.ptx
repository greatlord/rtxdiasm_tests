.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .f32 value;
    .reg .f32 result;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.f32 value, [in_addr];
    sin.approx.f32 result, value;
    st.global.f32 [out_addr], result;
    ret;
}
