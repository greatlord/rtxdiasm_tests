.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .shared .align 4 .b8 smem[16];
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u32 value;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.u32 value, [in_addr];
    st.shared.u32 [smem], value;
    bar.sync 0;
    ld.shared.u32 value, [smem];
    st.global.u32 [out_addr], value;
    ret;
}
