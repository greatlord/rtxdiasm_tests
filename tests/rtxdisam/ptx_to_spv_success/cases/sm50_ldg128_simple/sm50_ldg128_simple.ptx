.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .v4 .u32 value;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.v4.u32 value, [in_addr];
    st.global.v4.u32 [out_addr], value;
    ret;
}
