.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u64 addr;
    .reg .u64 offset;
    .reg .u32 index;
    .reg .u32 value;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.u32 index, [in_addr+4];
    mul.wide.u32 offset, index, 4;
    add.u64 addr, in_addr, offset;
    ld.global.u32 value, [addr];
    st.global.u32 [out_addr], value;
    ret;
}
