.version 6.0
.target sm_50
.address_size 64

.func (.reg .u32 %a, .reg .u32 %b, .reg .u32 %c) f(.param .u32 x)
{
    ld.param.u32 %a, [x];
    add.u32 %b, %a, 1;
    add.u32 %c, %a, 2;
    ret;
}

.visible .entry k(.param .u64 out, .param .u32 x)
{
    .reg .b32 %r<4>;
    .reg .b64 %rd<2>;
    .param .u32 slot;
    ld.param.u64 %rd0, [out];
    ld.param.u32 %r0, [x];
    st.param.u32 [slot], %r0;
    call.uni (%r0, %r1, %r2), f, (slot);
    st.global.u32 [%rd0], %r0;
    st.global.u32 [%rd0+4], %r1;
    st.global.u32 [%rd0+8], %r2;
    ret;
}
