.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .shared .align 4 .b8 smem[16];
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u64 base;
    .reg .u64 off64;
    .reg .u64 addr;
    .reg .u32 value;
    .reg .u32 addend;
    .reg .u32 old;
    .reg .u32 result;
    .reg .u32 off;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.u32 value, [in_addr];
    mov.u32 addend, 10;
    mov.u32 off, %tid.x;
    shl.b32 off, off, 2;
    mov.u64 base, smem;
    cvt.u64.u32 off64, off;
    add.u64 addr, base, off64;
    st.shared.u32 [addr], value;
    atom.shared.add.u32 old, [addr], addend;
    ld.shared.u32 result, [addr];
    st.global.u32 [out_addr], result;
    st.global.u32 [out_addr+4], old;
    ret;
}
