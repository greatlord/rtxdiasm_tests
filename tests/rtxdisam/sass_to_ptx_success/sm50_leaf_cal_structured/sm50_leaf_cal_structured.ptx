.version 6.0
.target sm_50
.address_size 64

.func (.param .u32 output) f(.param .u64 out, .param .u64 oldout, .param .u32 value)
{
    .reg .u64 p, o;
    .reg .u32 v, old, tid, now;
    .reg .pred first;
    ld.param.u64 p, [out];
    ld.param.u64 o, [oldout];
    ld.param.u32 v, [value];
    mov.u32 tid, %tid.x;
    mov.u32 old, 0;
    setp.eq.u32 first, tid, 0;
    @first atom.global.add.u32 old, [p], v;
    ld.global.u32 now, [p];
    st.global.u32 [o], old;
    st.param.u32 [output], now;
    ret;
}

.visible .entry k(.param .u64 out, .param .u64 oldout, .param .u32 value)
{
    .reg .u64 op, oo;
    .reg .u32 v, result;
    .param .u64 arg0, arg1;
    .param .u32 arg2;
    .param .u32 retval;
    ld.param.u64 op, [out];
    ld.param.u64 oo, [oldout];
    ld.param.u32 v, [value];
    st.param.u64 [arg0], op;
    st.param.u64 [arg1], oo;
    st.param.u32 [arg2], v;
    call (retval), f, (arg0, arg1, arg2);
    ld.param.u32 result, [retval];
    st.global.u32 [op], result;
    ret;
}
