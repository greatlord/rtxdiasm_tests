.version 6.0
.target sm_30
.address_size 64

.shared .align 4 .u32 s[1];

.visible .entry k(
    .param .u64 output
)
{
    .reg .u64 out_addr;
    .reg .u32 old;
    .reg .u32 current;

    ld.param.u64 out_addr, [output];
    st.shared.u32 [s], 0;
    atom.shared.add.u32 old, [s], 1;
    ld.shared.u32 current, [s];
    st.global.u32 [out_addr], old;
    st.global.u32 [out_addr+4], current;
    ret;
}
