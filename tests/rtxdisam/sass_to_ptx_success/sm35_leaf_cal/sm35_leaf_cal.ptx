.version 6.0
.target sm_35
.address_size 64

.func f(.param .u64 out)
{
    .reg .u64 p;
    ld.param.u64 p, [out];
    st.global.u32 [p], 7;
    ret;
}

.visible .entry k(
    .param .u64 out
)
{
    .reg .u64 out_reg;
    ld.param.u64 out_reg, [out];
    .param .u64 arg;
    st.param.u64 [arg], out_reg;
    call.uni f, (arg);
    ret;
}
