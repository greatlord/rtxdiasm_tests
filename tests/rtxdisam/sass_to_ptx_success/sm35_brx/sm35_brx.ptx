.version 6.0
.target sm_35
.address_size 64

.visible .entry k(
    .param .u32 selector
)
{
    .reg .u32 s;
    .reg .u32 result;

    ld.param.u32 s, [selector];
ts:
    .branchtargets L0, L1, L2;
    brx.idx s, ts;
L0:
    mov.u32 result, 10;
    ret;
L1:
    mov.u32 result, 11;
    ret;
L2:
    mov.u32 result, 12;
    ret;
}
