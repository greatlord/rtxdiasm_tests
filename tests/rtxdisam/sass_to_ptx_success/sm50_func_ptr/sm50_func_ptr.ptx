.version 6.0
.target sm_50
.address_size 64

.func (.param .u32 output) f(.param .u64 pin, .param .u64 pout)
{
    .reg .u32 v, w;
    .reg .u64 gp, pi, po;
    ld.param.u64 pi, [pin];
    ld.param.u64 po, [pout];
    cvta.to.global.u64 gp, pi;
    ld.global.u32 v, [gp];
    add.u32 w, v, 1;
    cvta.to.global.u64 gp, po;
    st.global.u32 [gp], w;
    add.u32 v, v, 2;
    st.param.u32 [output], v;
    ret;
}

.visible .entry k(.param .u64 pin, .param .u64 pout, .param .u64 out)
{
    .reg .u64 pi, po, op;
    .reg .u32 result;
    .param .u64 pa, pb;
    .param .u32 retval;
    ld.param.u64 pi, [pin];
    ld.param.u64 po, [pout];
    st.param.u64 [pa], pi;
    st.param.u64 [pb], po;
    call (retval), f, (pa, pb);
    ld.param.u32 result, [retval];
    ld.param.u64 op, [out];
    st.global.u32 [op], result;
    ret;
}
