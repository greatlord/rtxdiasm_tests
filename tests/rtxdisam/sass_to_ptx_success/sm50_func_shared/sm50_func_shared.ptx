.version 6.0
.target sm_50
.address_size 64
.shared .align 4 .b8 smem[16];

.func (.param .u32 output) f()
{
    .reg .u32 r;
    st.shared.u32 [smem], 5;
    bar.sync 0;
    ld.shared.u32 r, [smem];
    add.u32 r, r, 1;
    st.param.u32 [output], r;
    ret;
}

.visible .entry k(.param .u64 out)
{
    .reg .u64 op;
    .reg .u32 result;
    .param .u32 retval;
    call (retval), f, ();
    ld.param.u32 result, [retval];
    ld.param.u64 op, [out];
    st.global.u32 [op], result;
    ret;
}
