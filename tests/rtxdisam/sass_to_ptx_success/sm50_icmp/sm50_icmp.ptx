.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u32 value;
    .reg .u32 result;
    .reg .pred positive;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.u32 value, [in_addr];
    setp.gt.s32 positive, value, 0;
    @positive bra L1;
    mov.u32 result, 1;
    bra L2;
L1:
    mov.u32 result, 2;
L2:
    st.global.u32 [out_addr], result;
    ret;
}
