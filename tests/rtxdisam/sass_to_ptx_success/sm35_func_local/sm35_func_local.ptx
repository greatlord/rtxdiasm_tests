.version 6.0
.target sm_35
.address_size 64

.func (.param .u32 output) f(.param .u32 x)
{
    .reg .u32 r0, r1, r2;
    .local .align 4 .b8 tmp[8];
    ld.param.u32 r0, [x];
    st.local.u32 [tmp], r0;
    add.u32 r1, r0, 1;
    st.local.u32 [tmp+4], r1;
    ld.local.u32 r1, [tmp];
    ld.local.u32 r2, [tmp+4];
    add.u32 r0, r1, r2;
    st.param.u32 [output], r0;
    ret;
}

.visible .entry k(.param .u32 x, .param .u64 out)
{
    .reg .u32 input, result;
    .reg .u64 op;
    .param .u32 arg;
    .param .u32 retval;
    ld.param.u32 input, [x];
    ld.param.u64 op, [out];
    st.param.u32 [arg], input;
    call (retval), f, (arg);
    ld.param.u32 result, [retval];
    st.global.u32 [op], result;
    ret;
}
