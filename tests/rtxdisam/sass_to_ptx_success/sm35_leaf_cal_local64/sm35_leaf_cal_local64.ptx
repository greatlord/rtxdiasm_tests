.version 6.0
.target sm_35
.address_size 64

.func (.param .u32 output) f(.param .u32 x)
{
    .reg .u64 q, r;
    .reg .u32 x0, r0;
    .local .align 8 .b8 tmp[16];
    ld.param.u32 x0, [x];
    cvt.u64.u32 q, x0;
    st.local.u64 [tmp], q;
    ld.local.u64 r, [tmp];
    cvt.u32.u64 r0, r;
    st.param.u32 [output], r0;
    ret;
}

.visible .entry k(.param .u32 x, .param .u64 out)
{
    .reg .u32 input, result;
    .reg .u64 op;
    .param .u32 arg;
    .param .u32 retval;
    ld.param.u32 input, [x];
    ld.param.u64 op, [out];
    st.param.u32 [arg], input;
    call (retval), f, (arg);
    ld.param.u32 result, [retval];
    st.global.u32 [op], result;
    ret;
}
