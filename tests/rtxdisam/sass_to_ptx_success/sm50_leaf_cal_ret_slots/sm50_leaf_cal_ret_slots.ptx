.version 6.0
.target sm_50
.address_size 64

.func (.param .align 4 .b8 retval[80]) f(.param .u32 x)
{
    .reg .u32 r0;
    ld.param.u32 r0, [x];
    add.u32 r0, r0, 1;
    st.param.u32 [retval+0], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+4], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+8], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+12], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+16], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+20], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+24], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+28], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+32], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+36], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+40], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+44], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+48], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+52], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+56], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+60], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+64], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+68], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+72], r0;
    add.u32 r0, r0, 1;
    st.param.u32 [retval+76], r0;
    ret;
}

.visible .entry k(.param .u32 x, .param .u64 out)
{
    .reg .u32 r0, s;
    .reg .u64 op;
    .param .u32 arg;
    .param .align 4 .b8 retval[80];
    ld.param.u32 r0, [x];
    st.param.u32 [arg], r0;
    call (retval), f, (arg);
    mov.u32 s, 0;
    ld.param.u32 r0, [retval+0];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+4];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+8];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+12];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+16];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+20];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+24];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+28];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+32];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+36];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+40];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+44];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+48];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+52];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+56];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+60];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+64];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+68];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+72];
    add.u32 s, s, r0;
    ld.param.u32 r0, [retval+76];
    add.u32 s, s, r0;
    ld.param.u64 op, [out];
    st.global.u32 [op], s;
    ret;
}

