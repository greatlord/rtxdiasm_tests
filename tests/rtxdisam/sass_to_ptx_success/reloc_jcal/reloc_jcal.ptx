.version 6.0
.target sm_50
.address_size 64

.func (.param .u32 __ret) f(.param .u32 x)
{
    .reg .b32 %r<4>;
    ld.param.u32 %r0, [x];
    add.u32 %r0, %r0, 7;
    st.param.u32 [__ret], %r0;
    ret;
}

.visible .entry k(.param .u64 out, .param .u32 x)
{
    .reg .b32 %r<4>;
    .reg .b64 %rd<2>;
    .param .u32 slot;
    ld.param.u64 %rd0, [out];
    ld.param.u32 %r0, [x];
    st.param.u32 [slot], %r0;
    call.uni (%r1), f, (slot);
    st.global.u32 [%rd0], %r1;
    ret;
}
