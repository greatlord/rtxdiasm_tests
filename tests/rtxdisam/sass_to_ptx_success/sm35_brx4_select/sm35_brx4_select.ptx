.version 6.0
.target sm_35
.address_size 64

.visible .entry k(
    .param .u32 selector,
    .param .u64 out
)
{
    .reg .u32 s;
    .reg .u32 result;
    .reg .u64 p;
    ld.param.u32 s, [selector];
    ld.param.u64 p, [out];
ts:
    .branchtargets L0, L1, L2, L3;
    brx.idx s, ts;
L0:
    mov.u32 result, 10;
    bra done;
L1:
    mov.u32 result, 11;
    bra done;
L2:
    mov.u32 result, 12;
    bra done;
L3:
    mov.u32 result, 13;
done:
    st.global.u32 [p], result;
    ret;
}
