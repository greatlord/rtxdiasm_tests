.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .shared .align 4 .b8 smem[8];
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u32 value;
    .reg .u32 addend;
    .reg .u32 old;
    .reg .u32 result;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.u32 value, [in_addr];
    ld.global.u32 addend, [in_addr+4];
    st.shared.u32 [smem], value;
    atom.shared.add.u32 old, [smem], addend;
    ld.shared.u32 result, [smem];
    st.global.u32 [out_addr], result;
    st.global.u32 [out_addr+4], old;
    ret;
}
