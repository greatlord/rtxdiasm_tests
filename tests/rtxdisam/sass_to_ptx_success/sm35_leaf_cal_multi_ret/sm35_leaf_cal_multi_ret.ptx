.version 6.0
.target sm_35
.address_size 64

.func (.param .u32 output) f(.param .u32 x)
{
    .reg .u32 r0;
    .reg .pred p;
    ld.param.u32 r0, [x];
    setp.lt.u32 p, r0, 10;
    @p bra small;
    setp.gt.u32 p, r0, 20;
    @p bra large;
    add.u32 r0, r0, 100;
    st.param.u32 [output], r0;
    ret;
small:
    add.u32 r0, r0, 1;
    st.param.u32 [output], r0;
    ret;
large:
    add.u32 r0, r0, 1000;
    st.param.u32 [output], r0;
    ret;
}

.visible .entry k(.param .u32 x, .param .u64 out)
{
    .reg .u32 input, result;
    .reg .u64 out_reg;
    .param .u32 arg;
    .param .u32 retval;
    ld.param.u32 input, [x];
    st.param.u32 [arg], input;
    call (retval), f, (arg);
    ld.param.u32 result, [retval];
    ld.param.u64 out_reg, [out];
    st.global.u32 [out_reg], result;
    ret;
}
