.version 6.0
.target sm_50
.address_size 64

.func (.param .u32 output) f(.param .u32 a, .param .u32 b)
{
    .reg .u32 x, y, r;
    .reg .pred p;
    ld.param.u32 x, [a];
    ld.param.u32 y, [b];
    setp.lt.u32 p, x, y;
    selp.u32 r, x, y, p;
    add.u32 r, r, 100;
    st.param.u32 [output], r;
    ret;
}

.visible .entry k(.param .u32 a, .param .u32 b, .param .u64 out)
{
    .reg .u32 x, y, result;
    .reg .u64 op;
    .param .u32 pa, pb, retval;
    ld.param.u32 x, [a];
    ld.param.u32 y, [b];
    st.param.u32 [pa], x;
    st.param.u32 [pb], y;
    call (retval), f, (pa, pb);
    ld.param.u32 result, [retval];
    ld.param.u64 op, [out];
    st.global.u32 [op], result;
    ret;
}
