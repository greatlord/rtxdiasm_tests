.version 6.0
.target sm_35
.address_size 64

.func (.param .u32 output) f(.param .u32 n)
{
    .reg .u32 r0, r1, r2;
    .reg .pred p;
    ld.param.u32 r0, [n];
    mov.u32 r1, 0;
    setp.le.u32 p, r0, 0;
    @p bra done;
loop:
    add.u32 r1, r1, r0;
    sub.u32 r0, r0, 1;
    setp.gt.u32 p, r0, 0;
    @p bra loop;
done:
    st.param.u32 [output], r1;
    ret;
}

.visible .entry k(
    .param .u32 n,
    .param .u64 out
)
{
    .reg .u32 input;
    .reg .u32 result;
    .reg .u64 out_reg;
    .param .u32 arg;
    .param .u32 retval;
    ld.param.u32 input, [n];
    st.param.u32 [arg], input;
    call (retval), f, (arg);
    ld.param.u32 result, [retval];
    ld.param.u64 out_reg, [out];
    st.global.u32 [out_reg], result;
    ret;
}
