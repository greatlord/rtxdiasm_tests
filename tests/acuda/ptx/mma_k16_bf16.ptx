// Dense warp matmul mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32.
// Buffer layout (words): A 0..127 (4/lane), B 128..191 (2/lane),
// C 192..319 (4/lane), D 320..447 (4/lane).

.version 8.0
.target sm_80
.address_size 64

.visible .entry mma_k16_bf16(.param .u64 p)
{
    .reg .u64 %rd, %pa, %off, %zero;
    .reg .u32 %lane;
    .reg .b32 %a<4>, %b<2>;
    .reg .f32 %c<4>, %d<4>;

    ld.param.u64 %rd, [p];
    mov.u32 %lane, %laneid;
    mov.u64 %zero, 0;

    mad.wide.u32 %off, %lane, 16, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.b32 %a0, [%pa];
    ld.global.b32 %a1, [%pa+4];
    ld.global.b32 %a2, [%pa+8];
    ld.global.b32 %a3, [%pa+12];

    mad.wide.u32 %off, %lane, 8, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.b32 %b0, [%pa+512];
    ld.global.b32 %b1, [%pa+516];

    mad.wide.u32 %off, %lane, 16, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.f32 %c0, [%pa+768];
    ld.global.f32 %c1, [%pa+772];
    ld.global.f32 %c2, [%pa+776];
    ld.global.f32 %c3, [%pa+780];

    mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32
        {%d0,%d1,%d2,%d3}, {%a0,%a1,%a2,%a3}, {%b0,%b1},
        {%c0,%c1,%c2,%c3};

    st.global.f32 [%pa+1280], %d0;
    st.global.f32 [%pa+1284], %d1;
    st.global.f32 [%pa+1288], %d2;
    st.global.f32 [%pa+1292], %d3;
    ret;
}
