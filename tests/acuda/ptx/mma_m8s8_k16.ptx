.version 8.6
.target sm_80
.address_size 64

.visible .entry mma_m8s8_k16(.param .u64 output)
{
    .reg .u64       out_addr;
    .reg .u64       out_index;
    .reg .u32       thread_id;
    .reg .u32       in0, in1, in2, in3;
    .reg .u32       p1, p2, p3;
    .reg .b32       a, b;
    .reg .b32       c0, c1, d0, d1;

    ld.param.u64    out_addr, [output];
    mov.u32         thread_id, %tid.x;
    cvt.u32.u16     in0, thread_id;
    mul.lo.u32      in0, in0, 16;
    add.u32         in1, in0, 1;
    add.u32         in2, in0, 2;
    add.u32         in3, in0, 3;
    and.b32         in0, in0, 0xff;
    and.b32         in1, in1, 0xff;
    and.b32         in2, in2, 0xff;
    and.b32         in3, in3, 0xff;
    shl.b32         p1, in1, 8;
    shl.b32         p2, in2, 16;
    shl.b32         p3, in3, 24;
    mov.b32         a, in0;
    or.b32          a, a, p1;
    or.b32          a, a, p2;
    or.b32          a, a, p3;
    mov.b32         b, a;
    mov.b32         c0, in0;
    mov.b32         c1, in1;

    mma.sync.aligned.m8n8k16.row.col.s32.s8.s8.s32
        {d0, d1}, {a}, {b}, {c0, c1};

    cvt.u64.u32     out_index, thread_id;
    mul.lo.u64      out_index, out_index, 8;
    add.u64         out_addr, out_addr, out_index;
    st.b32          [out_addr], d0;
    st.b32          [out_addr+4], d1;
    ret;
}
