// ACUDA-EXTENSION: unresolved .extern .func host call; ptxas needs a companion module
.version 6.5
.target sm_30
.address_size 64
.extern .func (.param .align 16 .b8 func_retval0[16]) foobar
(
    .param .b64 value
);
.visible .entry hostcall_mix(.param .u64 input, .param .u64 output)
{
    .reg .u32 tid;
    .reg .u64 in_addr, out_addr, p, val, result, saved;
    .reg .pred pc;
    .shared .u64 s[1];
    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];
    ld.global.u64 val, [in_addr];
    mov.u32 tid, %tid.x;
    setp.ne.u32 pc, tid, 0;
    @pc bra L_shared;
    mov.u64 p, in_addr;
    bra L_call;
L_shared:
    mov.u64 p, s;
L_call:
    {
        .param .b64 p0;
        st.param.b64 [p0+0], val;
        .param .align 16 .b8 ret0[16];
        call.uni (ret0), foobar, (p0);
        ld.param.u64 result, [ret0];
    }
    st.u64 [p], result;
    @!pc bra L_done;
    ld.shared.u64 saved, [s];
    st.u64 [out_addr], saved;
L_done:
    ret;
}
