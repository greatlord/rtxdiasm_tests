.version 8.8
.target sm_120
.address_size 64
.visible .shared .b64 bar0;
.visible .shared .b64 bar1;
.visible .shared .u32 sbuf;
.visible .entry cp_async_mbarrier(.param .u64 p)
{
    .reg .u64 r;
    .reg .u32 v;
    .reg .pred done;
    ld.param.u64 r, [p];
    mbarrier.init.shared::cta.b64 [bar0], 2;
    mbarrier.init.shared::cta.b64 [bar1], 1;
    cp.async.ca.shared.global [sbuf], [r], 4;
    cp.async.mbarrier.arrive.noinc.shared::cta.b64 [bar0];
    mbarrier.arrive.shared::cta.b64 _, [bar0];
    mbarrier.try_wait.parity.shared::cta.b64 done, [bar0], 0;
    selp.u32 v, 1, 0, done;
    st.global.u32 [r+4], v;
    cp.async.ca.shared.global [sbuf+4], [r+8], 4;
    cp.async.mbarrier.arrive.shared::cta.b64 [bar1];
    mbarrier.arrive.shared::cta.b64 _, [bar1];
    mbarrier.try_wait.parity.shared::cta.b64 done, [bar1], 0;
    selp.u32 v, 1, 0, done;
    st.global.u32 [r+12], v;
    ld.shared.u32 v, [sbuf];
    st.global.u32 [r+16], v;
    ld.shared.u32 v, [sbuf+4];
    st.global.u32 [r+20], v;
    ret;
}
