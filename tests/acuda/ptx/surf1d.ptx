.version 8.6
.target sm_80
.address_size 64
.visible .entry surf1d(.param .surfref surf, .param .u64 out)
{
    .reg .u32 r0, r1;
    .reg .s32 x;
    .reg .u64 p;
    ld.param.u64 p, [out];
    mov.s32 x, 8;
    suld.b.1d.b32.trap r0, [surf, {x}];
    st.global.u32 [p], r0;
    mov.s32 x, 12;
    mov.u32 r1, 1234;
    sust.b.1d.b32.trap [surf, {x}], r1;
    ret;
}
