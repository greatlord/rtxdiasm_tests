.version 8.6
.target sm_80
.address_size 64
.visible .entry texa1d(.param .texref tex, .param .u64 out)
{
    .reg .f32 s, r0, r1, r2, r3;
    .reg .u32 idx;
    .reg .u64 p;
    ld.param.u64 p, [out];
    mov.u32 idx, 2;
    mov.f32 s, 0f3F000000;
    tex.a1d.v4.f32.f32 {r0, r1, r2, r3}, [tex, {idx, s}];
    st.global.f32 [p], r0;
    st.global.f32 [p+4], r1;
    st.global.f32 [p+8], r2;
    st.global.f32 [p+12], r3;
    ret;
}
