.version 8.8
.target sm_120
.address_size 64
.visible .shared .b32 s[8];
.visible .entry cp_async_forms(.param .u64 p)
{
    .reg .u64 ip;
    .reg .u32 n, r0, r1, r2, r3;
    .reg .pred p1;
    ld.param.u64 ip, [p];
    mov.u32 n, 8;
    cp.async.ca.shared::cta.global [s], [ip], 16, n;
    cp.async.commit_group;
    cp.async.wait_group 0;
    ld.shared.b32 r0, [s];
    ld.shared.b32 r1, [s+4];
    ld.shared.b32 r2, [s+8];
    ld.shared.b32 r3, [s+12];
    st.global.u32 [ip+64], r0;
    st.global.u32 [ip+68], r1;
    st.global.u32 [ip+72], r2;
    st.global.u32 [ip+76], r3;
    setp.eq.u32 p1, 0, 0;
    cp.async.ca.shared.global [s], [ip], 16, p1;
    cp.async.wait_all;
    ld.shared.b32 r0, [s];
    ld.shared.b32 r1, [s+4];
    ld.shared.b32 r2, [s+8];
    ld.shared.b32 r3, [s+12];
    st.global.u32 [ip+80], r0;
    st.global.u32 [ip+84], r1;
    st.global.u32 [ip+88], r2;
    st.global.u32 [ip+92], r3;
    ret;
}
