// Hand-written Phase 4 subset kernels: 1D vector add, f32 and u32.
// Uses ONLY the documented subset (see docs/ptx-subset.md).
.version 7.0
.target sm_80
.address_size 64

.visible .entry vecadd_f32(
    .param .u64 a,
    .param .u64 b,
    .param .u64 c,
    .param .u32 n
)
{
    .reg .u32 %r<8>;
    .reg .u64 %rd<8>;
    .reg .f32 %f<5>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [a];
    ld.param.u64 %rd2, [b];
    ld.param.u64 %rd3, [c];
    ld.param.u32 %r3, [n];

    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.u32 %r1, %r1, %r2, %r4;
    setp.ge.u32 %p1, %r1, %r3;
    @%p1 bra DONE;

    mul.wide.u32 %rd4, %r1, 4;
    add.u64 %rd5, %rd1, %rd4;
    add.u64 %rd6, %rd2, %rd4;
    add.u64 %rd7, %rd3, %rd4;
    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd6];
    mul.f32 %f4, %f1, 0F40000000;
    add.f32 %f3, %f4, %f2;
    st.global.f32 [%rd7], %f3;
DONE:
    ret;
}

.visible .entry vecadd_u32(
    .param .u64 a,
    .param .u64 b,
    .param .u64 c,
    .param .u32 n
)
{
    .reg .u32 %r<8>;
    .reg .u64 %rd<8>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [a];
    ld.param.u64 %rd2, [b];
    ld.param.u64 %rd3, [c];
    ld.param.u32 %r3, [n];

    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r4, %tid.x;
    mul.lo.u32 %r5, %r1, %r2;
    add.u32 %r1, %r5, %r4;
    setp.lt.u32 %p1, %r1, %r3;
    @!%p1 bra DONE;

    cvt.u64.u32 %rd4, %r1;
    add.u64 %rd4, %rd4, %rd4;
    add.u64 %rd4, %rd4, %rd4;
    add.u64 %rd5, %rd1, %rd4;
    add.u64 %rd6, %rd2, %rd4;
    add.u64 %rd7, %rd3, %rd4;
    ld.global.u32 %r5, [%rd5];
    ld.global.u32 %r6, [%rd6];
    add.u32 %r7, %r5, %r6;
    st.global.u32 [%rd7], %r7;
DONE:
    ret;
}
