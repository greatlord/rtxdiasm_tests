// Dynamic (cudaSurfaceObject_t-style) min/max surface operation.
.version 8.6
.target sm_80
.address_size 64
.visible .entry sured_dyn_minmax(.param .u64 hptr, .param .u64 out)
{
    .reg .u64 %rd1, %rd2, %rd3;
    .reg .u32 %r1, %r2;
    .reg .f32 %f1;
    ld.param.u64 %rd1, [hptr];
    ld.param.u64 %rd2, [out];
    ld.global.u64 %rd3, [%rd1];
    mov.u32 %r1, 0;
    mov.u32 %r2, 0;
    mov.f32 %f1, 0f40A00000; // 5.0
    sured.p.min.2d.f32.trap [%rd3, {%r1, %r2}], %f1;
    mov.u32 %r1, 1;
    sured.p.max.2d.f32.trap [%rd3, {%r1, %r2}], %f1;
    st.global.u32 [%rd2], 1;
    ret;
}
