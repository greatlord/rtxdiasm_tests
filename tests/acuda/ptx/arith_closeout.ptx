//
// Phase 4 close-out: div/rem (u32/s32/u64/s64, f32/f64), or/xor.b32/b64,
// u32 shifts, setp.s32. Must assemble with real ptxas AND compile+launch
// correctly here. sm_80, exact grid, N=4096 (thread 0 skips via a
// setp.s32 guard; d/e/f/g/c zeroed up front).
//
// Integer oracle (host C, exact): q=i/7, r=i%7, si=i-2000,
// sq=si/7, sr=si%7, d=q|(r<<20)|((sr+16)<<26), f=(u32)sq,
// q64=i/13, r64=i%13, si64=i-3000, sq64=si64/13, sr64=si64%13,
// e=(q64^r64)|((u64)sq64<<32)|((u64)(sr64+16)<<48).
// Float oracle: c=a/8+b/4 with a=i*8, b=i*4 (power-of-2 scaling is
// exact in every rounding mode), g=(double)a/8.
//
.version 8.6
.target sm_80
.address_size 64

.visible .entry arith_close(
    .param .u64 a,
    .param .u64 b,
    .param .u64 c,
    .param .u64 d,
    .param .u64 e,
    .param .u64 f,
    .param .u64 g
)
{
    .reg .u32 %r<16>;
    .reg .u64 %rd<32>;
    .reg .f32 %f<8>;
    .reg .f64 %fd<4>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [a];
    ld.param.u64 %rd2, [b];
    ld.param.u64 %rd3, [c];
    ld.param.u64 %rd4, [d];
    ld.param.u64 %rd5, [e];
    ld.param.u64 %rd6, [f];
    ld.param.u64 %rd7, [g];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.u32 %r4, %r2, %r3, %r1;
    sub.u32 %r5, %r4, 2000;
    setp.lt.s32 %p0, %r5, -1999;
    @%p0 bra DONE;

    div.u32 %r6, %r4, 7;
    rem.u32 %r7, %r4, 7;
    div.s32 %r8, %r5, 7;
    rem.s32 %r9, %r5, 7;
    add.u32 %r10, %r9, 16;
    shl.b32 %r11, %r7, 20;
    shl.b32 %r12, %r10, 26;
    or.b32 %r13, %r6, %r11;
    or.b32 %r14, %r13, %r12;
    mul.wide.u32 %rd8, %r4, 4;
    add.u64 %rd9, %rd4, %rd8;
    st.global.u32 [%rd9], %r14;
    add.u64 %rd10, %rd6, %rd8;
    st.global.u32 [%rd10], %r8;

    cvt.u64.u32 %rd11, %r4;
    div.u64 %rd12, %rd11, 13;
    rem.u64 %rd13, %rd11, 13;
    sub.u64 %rd14, %rd11, 3000;
    div.s64 %rd15, %rd14, 13;
    rem.s64 %rd16, %rd14, 13;
    xor.b64 %rd17, %rd12, %rd13;
    shl.b64 %rd18, %rd15, 32;
    add.u64 %rd19, %rd16, 16;
    shl.b64 %rd20, %rd19, 48;
    or.b64 %rd21, %rd17, %rd18;
    or.b64 %rd22, %rd21, %rd20;
    mul.wide.u32 %rd23, %r4, 8;
    add.u64 %rd24, %rd5, %rd23;
    st.global.u64 [%rd24], %rd22;

    add.u64 %rd25, %rd1, %rd8;
    add.u64 %rd26, %rd2, %rd8;
    add.u64 %rd27, %rd3, %rd8;
    ld.global.f32 %f1, [%rd25];
    ld.global.f32 %f2, [%rd26];
    div.rn.f32 %f3, %f1, 8.0;
    div.approx.f32 %f4, %f2, 4.0;
    add.f32 %f5, %f3, %f4;
    st.global.f32 [%rd27], %f5;
    cvt.f64.f32 %fd1, %f1;
    div.rn.f64 %fd2, %fd1, 8.0;
    add.u64 %rd28, %rd7, %rd23;
    st.global.f64 [%rd28], %fd2;

DONE:
    ret;
}
