.version 8.6
.target sm_80
.address_size 64
.visible .entry cfg_loop_multi(.param .u64 io)
{
    .reg .u64 rd;
    .reg .u32 r1, r2, r3;
    .reg .pred p0;
    .reg .pred p1;
    ld.param.u64 rd, [io];
    ld.global.u32 r1, [rd];
    ld.global.u32 r2, [rd+4];
    mov.u32 r3, 0;
    setp.eq.u32 p1, r2, 1;
    @p1 bra LOOP;
    add.u32 r3, r3, 100;
LOOP:
    add.u32 r3, r3, 1;
    setp.lt.u32 p0, r3, r1;
    @p0 bra LOOP;
    st.global.u32 [rd], r3;
    ret;
}
