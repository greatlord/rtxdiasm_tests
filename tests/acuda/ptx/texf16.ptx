.version 8.6
.target sm_80
.address_size 64
.visible .entry texf16(.param .texref tex, .param .u64 out)
{
    .reg .f32 s, t;
    .reg .f16 h0, h1, h2, h3;
    .reg .u64 p;
    ld.param.u64 p, [out];
    mov.f32 s, 0f3E800000;
    mov.f32 t, 0f3E800000;
    tex.2d.v4.f16.f32 {h0, h1, h2, h3}, [tex, {s, t}];
    st.global.b16 [p], h0;
    st.global.b16 [p+2], h1;
    st.global.b16 [p+4], h2;
    st.global.b16 [p+6], h3;
    ret;
}
