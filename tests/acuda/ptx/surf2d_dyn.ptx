.version 8.6
.target sm_80
.address_size 64
.visible .entry surf2d_dyn(.param .u64 hptr, .param .u64 out)
{
    .reg .u64 h, hp, p;
    .reg .u32 r0, r1, w;
    .reg .s32 x, y;
    ld.param.u64 hp, [hptr];
    ld.param.u64 p, [out];
    ld.global.u64 h, [hp];
    mov.s32 x, 4;
    mov.s32 y, 0;
    suld.b.2d.b32.trap r0, [h, {x, y}];
    st.global.u32 [p], r0;
    mov.s32 x, 8;
    mov.s32 y, 0;
    mov.u32 r1, 777;
    sust.b.2d.b32.trap [h, {x, y}], r1;
    suq.width.b32 w, [h];
    st.global.u32 [p+4], w;
    ret;
}
