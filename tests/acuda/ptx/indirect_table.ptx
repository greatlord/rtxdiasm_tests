.version 6.5
.target sm_30
.address_size 64
.func (.reg .u64 out) add_one(.reg .u64 x)
{
    add.u64 out, x, 0x10;
    ret;
}
.func (.reg .u64 out) add_two(.reg .u64 x)
{
    add.u64 out, x, 0x20;
    ret;
}
.global .u64 tbl[2] = { add_one, add_two };
.visible .entry indirect_table(.param .u64 data)
{
    .reg .u64 base, val, r, f, p, off;
    .reg .u32 idx;
    ld.param.u64 base, [data];
    ld.global.u64 val, [base];
    cvt.u32.u64 idx, val;
    mov.u64 p, tbl;
    mul.wide.u32 off, idx, 8;
    add.u64 p, p, off;
    ld.global.u64 f, [p];
tgt: .calltargets add_one, add_two;
    call (r), f, (val), tgt;
    st.u64 [base+8], r;
    ret;
}
