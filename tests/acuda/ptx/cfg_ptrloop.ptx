.version 8.6
.target sm_80
.address_size 64
.visible .entry cfg_ptrloop(.param .u64 io)
{
    .reg .u64 rd, p;
    .reg .u32 r1, r2;
    .reg .pred p0, p1;
    ld.param.u64 rd, [io];
    ld.global.u32 r1, [rd];
    mov.u64 p, rd;
    mov.u32 r2, 0;
    setp.eq.u32 p1, r1, 1;
    @p1 bra LOOP;
    add.u64 p, p, 4;
LOOP:
    add.u64 p, p, 4;
    add.u32 r2, r2, 1;
    setp.lt.u32 p0, r2, 1;
    @p0 bra LOOP;
    st.global.u32 [p], r2;
    ret;
}
