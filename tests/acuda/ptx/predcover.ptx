// Predicated-execution coverage: data-dependent pred drives select
// desugars (taken + skipped, plain + negated + chained) and one
// trailing predicated store (guard taken + skipped across launches).
.version 6.5
.target sm_30
.address_size 64

.visible .entry predcover(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64  in_addr;
    .reg .u64  out_addr;
    .reg .u32  x;
    .reg .u32  y;
    .reg .pred p;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.u32       x, [in_addr];
    setp.ne.u32  p, x, 0;
    mov.u32      y, 7;
    @p add.u32   y, x, 100;
    @!p add.u32  y, y, 1;
    st.u32       [out_addr], y;
    @p st.u32    [out_addr+4], y;
    ret;
}
