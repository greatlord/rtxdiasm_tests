// ACUDA-EXTENSION: unresolved .extern .func host call; ptxas needs a companion module
.version 6.5
.target sm_30
.address_size 64
.extern .func (.param .align 16 .b8 func_retval0[16]) foobar
(
    .param .b64 a0, .param .b64 a1, .param .b64 a2, .param .b64 a3,
    .param .b64 a4, .param .b64 a5, .param .b64 a6, .param .b64 a7,
    .param .b64 a8, .param .b64 a9
);
.visible .entry hostcall_args(.param .u64 input, .param .u64 output)
{
    .reg .u64 in_addr, out_addr, val, r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, result;
    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];
    ld.global.u64 val, [in_addr];
    mov.u64 r0, 1; mov.u64 r1, 2; mov.u64 r2, 3; mov.u64 r3, 4; mov.u64 r4, 5;
    mov.u64 r5, 6; mov.u64 r6, 7; mov.u64 r7, 8; mov.u64 r8, 9; mov.u64 r9, 10;
    {
        .param .b64 p0, p1, p2, p3, p4, p5, p6, p7, p8, p9;
        st.param.b64 [p0+0], r0; st.param.b64 [p1+0], r1;
        st.param.b64 [p2+0], r2; st.param.b64 [p3+0], r3;
        st.param.b64 [p4+0], r4; st.param.b64 [p5+0], r5;
        st.param.b64 [p6+0], r6; st.param.b64 [p7+0], r7;
        st.param.b64 [p8+0], r8; st.param.b64 [p9+0], r9;
        .param .align 16 .b8 ret0[16];
        call.uni (ret0), foobar, (p0,p1,p2,p3,p4,p5,p6,p7,p8,p9);
        ld.param.u64 result, [ret0];
    }
    st.u64 [out_addr], result;
    ret;
}
