// ACUDA-EXTENSION: unresolved .extern .func host call; ptxas needs a companion module
.version 6.5
.target sm_30
.address_size 64

.extern .func (.param .align 16 .b8 func_retval0[16]) foobar
(
    .param .b64 value
);

.visible .entry hostcall2(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u64 temp;
    .reg .u64 r1;
    .reg .u64 temp2;
    .reg .u64 r2;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];
    ld.global.u64 temp, [in_addr];

    {
        .param .b64 p0;
        st.param.b64 [p0+0], temp;
        .param .align 16 .b8 ret0[16];
        call.uni (ret0), foobar, (p0);
        ld.param.u64 r1, [ret0];
    }
    add.u64 temp2, r1, 1;
    {
        .param .b64 p1;
        st.param.b64 [p1+0], temp2;
        .param .align 16 .b8 ret1[16];
        call.uni (ret1), foobar, (p1);
        ld.param.u64 r2, [ret1];
    }
    st.u64 [out_addr], r2;
    ret;
}
