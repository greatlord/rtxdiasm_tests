.version 8.6
.target sm_80
.address_size 64
.visible .entry tex1dfetch(.param .texref tex, .param .u64 out)
{
    .reg .s32 x;
    .reg .f32 r0, r1, r2, r3;
    .reg .u64 p;
    ld.param.u64 p, [out];
    mov.s32 x, 2;
    tex.1d.v4.f32.s32 {r0, r1, r2, r3}, [tex, {x}];
    st.global.f32 [p], r0;
    st.global.f32 [p+4], r1;
    st.global.f32 [p+8], r2;
    st.global.f32 [p+12], r3;
    ret;
}
