.version 8.6
.target sm_80
.address_size 64
// Directed-rounding f32 multiply (software FMA with a zero addend).
.visible .entry mul_dir(.param .u64 data)
{
    .reg .u64 base;
    .reg .f32 a, b, r;
    ld.param.u64 base, [data];
    ld.f32 a, [base];
    ld.f32 b, [base+4];
    mul.rp.f32 r, a, b;
    st.f32 [base+8], r;
    mul.rm.f32 r, a, b;
    st.f32 [base+12], r;
    mul.rz.f32 r, a, b;
    st.f32 [base+16], r;
    mul.rn.f32 r, a, b;
    st.f32 [base+20], r;
    ret;
}
