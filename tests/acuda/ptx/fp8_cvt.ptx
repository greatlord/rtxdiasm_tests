// FP8 conversions verified on-GPU against NVIDIA's cuda_fp8.hpp
// (literal reference model checked bit-exact over 2.3M patterns):
//   cvt.rn.satfinite.e4m3x2.f32 / e5m2x2.f32  (first src -> high byte)
//   cvt.rn.f16x2.e4m3x2 / e5m2x2             (low byte -> low half)
// 64 lanes, each converting the pair in_g[2t], in_g[2t+1] and writing
//   out[4t] = e4m3x2, out[4t+1] = e5m2x2, out[4t+2] = f16x2(e4m3),
//   out[4t+3] = f16x2(e5m2).  Inputs cover zeros, NaN/Inf, denormals,
// rounding ties for both formats, saturation boundaries and random
// finite patterns. Expected words live in the driver's .inc.

.version 8.6
.target sm_90
.address_size 64

.global .align 4 .b32 in_g[128] = {
    0, 2147483648, 1065353216, 3212836864, 1073741824, 3221225472, 1056964608, 1138753536,
    3286237184, 1139277824, 3286761472, 1139802112, 1197473792, 3344957440, 1198522368, 3346006016,
    1199570944, 2139095040, 4286578688, 2143289344, 2139095041, 4290772992, 2147483647, 981467136,
    922746880, 989855744, 931135488, 1015021568, 947912704, 994050048, 1000341504, 1004535808,
    935329792, 941621248, 945815552, 994050048, 1000341504, 1053818880, 1095657062, 1052770304,
    3315877069, 228737632, 2376221280, 2139081118, 4286564766, 1, 2147483649, 8388607,
    8388608, 1065353215, 1065353216, 1065877504, 3213361152, 1066401792, 3213885440, 1066926080,
    3214409728, 1067450368, 3214934016, 1067974656, 3215458304, 1068498944, 3215982592, 1069023232,
    3216506880, 1069547520, 3217031168, 1070071808, 3217555456, 1070596096, 3218079744, 1071120384,
    3218604032, 1071644672, 3219128320, 1072168960, 3219652608, 1072693248, 3220176896, 1073217536,
    3220701184, 1138786304, 3286269952, 1138819072, 3286302720, 1138851840, 3286335488, 1138884608,
    3286368256, 1138917376, 3286401024, 1138950144, 3286433792, 1138982912, 3286466560, 1139015680,
    3286499328, 1139048448, 3286532096, 1139081216, 3286564864, 1139113984, 3286597632, 1139146752,
    3286630400, 1139179520, 3286663168, 1139212288, 3286695936, 1139245056, 3286728704, 1197735936,
    3345219584, 1197998080, 3345481728, 1198260224, 3345743872, 1198522368, 3346006016, 1198784512,
    3346268160, 1199046656, 3346530304, 1199308800, 3346792448, 3410634256, 872822211, 991823374
};

.visible .entry fp8_cvt(
    .param .u64 out_p
)
{
    .reg .u64           %out, %ga, %oa, %tmp;
    .reg .u32           %t, %off, %w;
    .reg .f32           %a, %b;
    .reg .b16           %e4, %e5;
    .reg .b32           %h4, %h5;

    ld.param.u64        %out, [out_p];
    mov.u32             %t, %tid.x;
    shl.b32             %off, %t, 3;
    cvt.u64.u32         %tmp, %off;
    mov.u64             %ga, in_g;
    add.u64             %ga, %ga, %tmp;
    ld.f32              %a, [%ga];
    ld.f32              %b, [%ga + 4];

    cvt.rn.satfinite.e4m3x2.f32 %e4, %a, %b;
    cvt.rn.satfinite.e5m2x2.f32 %e5, %a, %b;
    cvt.rn.f16x2.e4m3x2 %h4, %e4;
    cvt.rn.f16x2.e5m2x2 %h5, %e5;

    shl.b32             %off, %t, 4;
    cvt.u64.u32         %tmp, %off;
    add.u64             %oa, %out, %tmp;
    st.b16              [%oa], %e4;
    st.b16              [%oa + 4], %e5;
    st.b32              [%oa + 8], %h4;
    st.b32              [%oa + 12], %h5;
    ret;
}
