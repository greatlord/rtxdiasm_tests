// Dense mma m16n8k64 u4 x u4 -> s32.
// A 0..511, B 512..767, C 768..1279, D 1280..1791 (bytes).

.version 8.0
.target sm_80
.address_size 64

.visible .entry mma_int4_s4_m16n8k64(.param .u64 p)
{
    .reg .u64 %rd, %pa, %off, %zero;
    .reg .u32 %lane;
    .reg .b32 %a<4>, %b<2>;
    .reg .s32 %c<4>, %d<4>;

    ld.param.u64 %rd, [p];
    mov.u32 %lane, %laneid;
    mov.u64 %zero, 0;

    mad.wide.u32 %off, %lane, 16, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.b32 %a0, [%pa];
    ld.global.b32 %a1, [%pa+4];
    ld.global.b32 %a2, [%pa+8];
    ld.global.b32 %a3, [%pa+12];

    mad.wide.u32 %off, %lane, 8, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.b32 %b0, [%pa+512];
    ld.global.b32 %b1, [%pa+516];

    mad.wide.u32 %off, %lane, 16, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.s32 %c0, [%pa+768];
    ld.global.s32 %c1, [%pa+772];
    ld.global.s32 %c2, [%pa+776];
    ld.global.s32 %c3, [%pa+780];

    mma.sync.aligned.m16n8k64.row.col.s32.s4.s4.s32
        {%d0,%d1,%d2,%d3}, {%a0,%a1,%a2,%a3}, {%b0,%b1},
        {%c0,%c1,%c2,%c3};

    st.global.s32 [%pa+1280], %d0;
    st.global.s32 [%pa+1284], %d1;
    st.global.s32 [%pa+1288], %d2;
    st.global.s32 [%pa+1292], %d3;
    ret;
}
