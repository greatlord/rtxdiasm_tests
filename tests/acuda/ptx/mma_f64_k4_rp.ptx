// Dense warp matmul m16n8k4 f64 with round-toward-positive-infinity accumulation.
// Per-lane fragments: A 2, B 1, C/D 4 .f64 registers.

.version 8.0
.target sm_90
.address_size 64

.visible .entry mma_f64_k4_rp(.param .u64 p)
{
    .reg .u64 %rd, %pa, %off, %zero;
    .reg .u32 %lane;
    .reg .f64 %a<2>, %b<1>, %c<4>, %d<4>;

    ld.param.u64 %rd, [p];
    mov.u32 %lane, %laneid;
    mov.u64 %zero, 0;

    mad.wide.u32 %off, %lane, 16, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.f64 %a0, [%pa+0];
    ld.global.f64 %a1, [%pa+8];
    mad.wide.u32 %off, %lane, 8, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.f64 %b0, [%pa+512];
    mad.wide.u32 %off, %lane, 32, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.f64 %c0, [%pa+768];
    ld.global.f64 %c1, [%pa+776];
    ld.global.f64 %c2, [%pa+784];
    ld.global.f64 %c3, [%pa+792];
    mma.sync.aligned.m16n8k4.row.col.f64.f64.f64.f64.rp
        {%d0,%d1,%d2,%d3}, {%a0,%a1}, {%b0},
        {%c0,%c1,%c2,%c3};

    st.global.f64 [%pa+1792], %d0;
    st.global.f64 [%pa+1800], %d1;
    st.global.f64 [%pa+1808], %d2;
    st.global.f64 [%pa+1816], %d3;
    ret;
}
