.version 8.6
.target sm_80
.address_size 64
.visible .entry ldu_vec(.param .u64 data)
{
    .reg .u64 base;
    .reg .u32 r0, r1, r2, r3, r4, r5;
    .reg .u64 q0, q1, q2, q3;
    ld.param.u64 base, [data];
    ldu.global.v4.u32 {r0, r1, r2, r3}, [base];
    st.global.v4.u32 [base+32], {r0, r1, r2, r3};
    ldu.global.v2.u64 {q0, q1}, [base+16];
    st.global.v2.u64 [base+48], {q0, q1};
    ret;
}
