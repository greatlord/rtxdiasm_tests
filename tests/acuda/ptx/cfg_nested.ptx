.version 8.6
.target sm_80
.address_size 64
.visible .entry cfg_nested(.param .u64 io)
{
    .reg .u64 rd;
    .reg .u32 i, j, n;
    .reg .pred p0, p1;
    ld.param.u64 rd, [io];
    ld.global.u32 n, [rd];
    mov.u32 i, 0;
OUTER:
    mov.u32 j, 0;
INNER:
    add.u32 j, j, 1;
    setp.lt.u32 p0, j, 3;
    @p0 bra INNER;
    add.u32 i, i, j;
    add.u32 i, i, 1;
    setp.lt.u32 p1, i, n;
    @p1 bra OUTER;
    st.global.u32 [rd], i;
    ret;
}
