// Counted barriers (software counters), bar.arrive, and a bare bar.sync.
// Block size 64 (two warps); every thread stores its id afterwards.
.version 8.0
.target sm_80
.address_size 64
.visible .entry counted_bar(.param .u64 p)
{
    .reg .u64 %rd<3>;
    .reg .u32 %r<3>;
    ld.param.u64 %rd1, [p];
    mov.u32 %r1, %tid.x;
    shl.b32 %r2, %r1, 2;
    cvt.u64.u32 %rd2, %r2;
    add.u64 %rd2, %rd1, %rd2;

    bar.arrive 0, 64;
    bar.sync 0, 64;
    bar.sync 1, 32;
    bar.sync 2, 64;
    bar.sync 3;
    st.global.u32 [%rd2], %r1;
    ret;
}
