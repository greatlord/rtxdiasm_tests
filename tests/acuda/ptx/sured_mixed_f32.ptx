// Mixed formatted surface operations on the same R32f fallback binding:
// sured.min plus a formatted sust.p store.
.version 8.6
.target sm_80
.address_size 64
.visible .entry sured_mixed_f32(.param .surfref surf, .param .u64 out)
{
    .reg .u32 %r<4>;
    .reg .f32 %f<2>;
    .reg .u64 %rd<2>;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, 0;
    mov.u32 %r2, 0;
    mov.f32 %f1, 0f40A00000;
    sured.p.min.2d.f32.trap [surf, {%r1, %r2}], %f1;
    mov.u32 %r1, 1;
    mov.f32 %f1, 0f42F60000;
    sust.p.2d.b32.trap [surf, {%r1, %r2}], %f1;
    mov.u32 %r3, 30;
    st.global.u32 [%rd1], %r3;
    ret;
}
