.version 7.1
.target sm_86
.address_size 64
.shared .align 8 .b8 sbuf[8];
.visible .entry pvm(.param .u64 out)
{
    .reg .b32 %r0, %r1, %r2, %r3, %r4;
    .reg .pred %p;
    .reg .b64 %rd0, %rd2;
    ld.param.u64 %rd0, [out];
    mov.b32 %r0, 0x11111111;
    mov.b32 %r1, 0x22222222;
    st.shared.v2.u32 [sbuf], {%r0, %r1};
    // False predicate: the vector load must leave both words alone.
    mov.b32 %r0, 0xaaaaaaaa;
    mov.b32 %r1, 0xbbbbbbbb;
    setp.eq.u32 %p, 0, 1;
    @%p ld.shared.v2.u32 {%r0, %r1}, [sbuf];
    st.global.v2.u32 [%rd0], {%r0, %r1};
    // False predicate: the vector store must not write.
    setp.eq.u32 %p, 0, 1;
    mov.b32 %r2, 0xdeadbeef;
    mov.b32 %r3, 0xfeedface;
    @%p st.shared.v2.u32 [sbuf], {%r2, %r3};
    // True predicate: load the untouched shared words.
    setp.eq.u32 %p, 1, 1;
    @%p ld.shared.v2.u32 {%r2, %r3}, [sbuf];
    st.global.v2.u32 [%rd0+8], {%r2, %r3};
    // RZ in a brace destination discards the low word.
    mov.b64 %rd2, 0x123456789abcdef0;
    mov.b64 {RZ, %r4}, %rd2;
    st.global.u32 [%rd0+16], %r4;
    ret;
}
