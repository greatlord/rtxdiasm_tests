// ACUDA-EXTENSION: PTX ISA 9.2+ family-specific forms (sm_120f+):
// add.sat.u32, packed add.sat, and packed byte add/sub. Validated with
// CUDA 13.3 ptxas (PTX 9.3); the bundled CUDA 12.9 ptxas predates
// these spellings, so ptx_sass_ref skips this file.
// Per ptxas: packed u16x2/s16x2 add and sub are both valid; sub.sat
// accepts only .s32, .u8x4 and .s8x4.
.version 9.3
.target sm_120f
.address_size 64
.visible .entry add_sub_family(.param .u64 p)
{
    .reg .u64 %rd1;
    .reg .u32 %a, %b, %d;
    .reg .b32 %pa, %pb, %pd;
    ld.param.u64 %rd1, [p];

    // add.sat.u32: 0xFFFFFFF0 + 0x20 clamps to UINT_MAX.
    ld.global.u32 %a, [%rd1];
    ld.global.u32 %b, [%rd1+4];
    add.sat.u32 %d, %a, %b;
    st.global.u32 [%rd1+24], %d;

    // Packed half-word saturating add: a=(0xFFF0,0x0001), b=(0x0020,0x0002).
    ld.global.b32 %pa, [%rd1+8];
    ld.global.b32 %pb, [%rd1+12];
    add.sat.u16x2 %pd, %pa, %pb;
    st.global.b32 [%rd1+28], %pd;
    add.sat.s16x2 %pd, %pa, %pb;
    st.global.b32 [%rd1+32], %pd;

    // Packed byte a=(0x80,0xFF,0xFF,0xF0), b=(0x01,0x02,0x03,0x20).
    ld.global.b32 %pa, [%rd1+16];
    ld.global.b32 %pb, [%rd1+20];
    add.sat.u8x4 %pd, %pa, %pb;
    st.global.b32 [%rd1+36], %pd;
    add.sat.s8x4 %pd, %pa, %pb;
    st.global.b32 [%rd1+40], %pd;
    sub.sat.u8x4 %pd, %pa, %pb;
    st.global.b32 [%rd1+44], %pd;
    sub.sat.s8x4 %pd, %pa, %pb;
    st.global.b32 [%rd1+48], %pd;

    // Plain packed byte sub (wrap).
    sub.u8x4 %pd, %pa, %pb;
    st.global.b32 [%rd1+52], %pd;
    sub.s8x4 %pd, %pa, %pb;
    st.global.b32 [%rd1+56], %pd;

    // Plain packed half-word sub (wrap).
    ld.global.b32 %pa, [%rd1+8];
    ld.global.b32 %pb, [%rd1+12];
    sub.u16x2 %pd, %pa, %pb;
    st.global.b32 [%rd1+60], %pd;
    sub.s16x2 %pd, %pa, %pb;
    st.global.b32 [%rd1+64], %pd;
    ret;
}
