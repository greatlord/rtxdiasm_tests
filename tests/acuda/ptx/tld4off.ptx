.version 8.6
.target sm_80
.address_size 64
.visible .entry tld4off(.param .texref tex, .param .u64 out)
{
    .reg .f32 s, t, r0, r1, r2, r3;
    .reg .s32 ox, oy;
    .reg .u64 p;
    ld.param.u64 p, [out];
    mov.f32 s, 0f3F000000;
    mov.f32 t, 0f3F000000;
    mov.s32 ox, 0;
    mov.s32 oy, 0;
    tld4.r.2d.v4.f32.f32 {r0, r1, r2, r3}, [tex, {s, t}], {ox, oy};
    st.global.f32 [p], r0;
    st.global.f32 [p+4], r1;
    st.global.f32 [p+8], r2;
    st.global.f32 [p+12], r3;
    ret;
}
