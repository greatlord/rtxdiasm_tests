// cvt int<->float corners (sm_86).
.version 8.0
.target sm_86
.address_size 64

.visible .entry cvt_int_float(.param .u64 p)
{
    .reg .u64 %rd;
    .reg .s32 %i;
    .reg .u32 %u;
    .reg .s64 %l;
    .reg .u64 %ul;
    .reg .f32 %f, %f2;
    .reg .f64 %d;
    .reg .b16 %h;

    ld.param.u64 %rd, [p];
    mov.s32 %i, -3;
    mov.s64 %l, -7;

    cvt.rn.f32.s32 %f, %i;
    st.global.f32 [%rd], %f;
    cvt.rn.f64.s64 %d, %l;
    st.global.f64 [%rd+8], %d;
    cvt.rn.f16.s32 %h, %i;
    cvt.u32.u16 %u, %h;
    st.global.u32 [%rd+16], %u;

    mov.f32 %f2, 0fc06ccccd;   // -3.7
    cvt.rzi.s32.f32 %i, %f2;
    st.global.u32 [%rd+20], %i;
    mov.f32 %f2, 0f409ccccd;   // 4.9
    cvt.rzi.s64.f32 %l, %f2;
    st.global.u64 [%rd+24], %l;
    mov.f64 %d, 0d4013333333333333; // 4.9
    cvt.rzi.u64.f64 %ul, %d;
    st.global.u64 [%rd+32], %ul;
    cvt.rni.u32.f32 %u, %f2;
    st.global.u32 [%rd+40], %u;

    mov.f64 %d, 0d4012000000000000; // 4.5
    cvt.rni.s64.f64 %l, %d;
    st.global.u64 [%rd+48], %l;
    mov.f64 %d, 0dc010cccccccccccd; // -4.2
    cvt.rmi.s64.f64 %l, %d;
    st.global.u64 [%rd+56], %l;
    mov.f64 %d, 0d4010cccccccccccd; // 4.2
    cvt.rpi.s64.f64 %l, %d;
    st.global.u64 [%rd+64], %l;
    mov.f64 %d, 0d4004000000000000; // 2.5
    cvt.rni.f64.f64 %d, %d;
    st.global.f64 [%rd+72], %d;
    ret;
}
