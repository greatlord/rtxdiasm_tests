.version 8.6
.target sm_90
.address_size 64
.shared .u32 sv[32];
.visible .entry cluster_bar(.param .u64 io)
{
    .reg .u64 rd, sp, base, off64;
    .reg .u32 t, u;
    ld.param.u64 rd, [io];
    mov.u32 t, %tid.x;
    mov.u64 sp, sv;
    mul.wide.u32 off64, t, 4;
    add.u64 sp, sp, off64;
    st.shared.u32 [sp], t;
    barrier.cluster.arrive;
    barrier.cluster.wait;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    barrier.cluster.arrive.relaxed;
    barrier.cluster.wait.aligned;
    add.u32 u, t, 1;
    and.b32 u, u, 31;
    mul.wide.u32 off64, u, 4;
    mov.u64 sp, sv;
    add.u64 sp, sp, off64;
    ld.shared.u32 u, [sp];
    mul.wide.u32 off64, t, 4;
    add.u64 base, rd, off64;
    st.global.u32 [base], u;
    ret;
}
