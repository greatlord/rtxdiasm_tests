// Module-scope .texref declaration plus a trivial write.  The texture
// binding path is exercised separately; this test ensures the legacy
// declaration is accepted without disturbing normal compilation.
.version 8.0
.target sm_80
.address_size 64

.texref .f32 tex0;

.visible .entry texref_decl(.param .u64 p)
{
    .reg .u64 %rd, %off, %pa;
    .reg .u32 %lane, %v;

    ld.param.u64 %rd, [p];
    mov.u32 %lane, %laneid;
    cvt.u64.u32 %off, %lane;
    shl.b64 %off, %off, 2;
    add.u64 %pa, %rd, %off;
    mov.u32 %v, 7;
    st.global.u32 [%pa], %v;
    ret;
}
