.version 8.6
.target sm_80
.address_size 64
.visible .entry texms(.param .texref tex, .param .u64 out)
{
    .reg .s32 x, y, pad, r0, r1, r2, r3;
    .reg .u32 sample;
    .reg .u64 p;
    ld.param.u64 p, [out];
    mov.u32 sample, 0;
    mov.s32 x, 1;
    mov.s32 y, 1;
    mov.s32 pad, 0;
    tex.2dms.v4.s32.s32 {r0, r1, r2, r3}, [tex, {sample, x, y, pad}];
    st.global.s32 [p], r0;
    st.global.s32 [p+4], r1;
    st.global.s32 [p+8], r2;
    st.global.s32 [p+12], r3;
    ret;
}
