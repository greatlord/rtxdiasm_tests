// Dense warp matmul mma.sync.aligned.m16n8k8.row.col.f32.f16.f16.f32.
// Buffer layout (words): A 0..63 (2/lane), B 64..95 (1/lane),
// C 96..223 (4/lane), D 224..351 (4/lane).

.version 8.0
.target sm_80
.address_size 64

.visible .entry mma_k8(.param .u64 p)
{
    .reg .u64 %rd, %pa, %off, %zero;
    .reg .u32 %lane;
    .reg .b32 %a<2>, %b;
    .reg .f32 %c<4>, %d<4>;

    ld.param.u64 %rd, [p];
    mov.u32 %lane, %laneid;
    mov.u64 %zero, 0;

    mad.wide.u32 %off, %lane, 8, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.b32 %a0, [%pa];
    ld.global.b32 %a1, [%pa+4];

    mad.wide.u32 %off, %lane, 4, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.b32 %b, [%pa+256];

    mad.wide.u32 %off, %lane, 16, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.f32 %c0, [%pa+384];
    ld.global.f32 %c1, [%pa+388];
    ld.global.f32 %c2, [%pa+392];
    ld.global.f32 %c3, [%pa+396];

    mma.sync.aligned.m16n8k8.row.col.f32.f16.f16.f32
        {%d0,%d1,%d2,%d3}, {%a0,%a1}, {%b}, {%c0,%c1,%c2,%c3};

    st.global.f32 [%pa+896], %d0;
    st.global.f32 [%pa+900], %d1;
    st.global.f32 [%pa+904], %d2;
    st.global.f32 [%pa+908], %d3;
    ret;
}
