// Integer warp matmul mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32,
// lowered by shuffle-gather. Lane t feeds in_k = (16*t + k) & 0xFFFF,
// packs four of them byte-wise into each A register (and two B
// registers), and stores its four s32 accumulators contiguously at
// byte t*16. Expected words are pinned in the driver test against the
// same NVIDIA-generated vectors ZLUDA uses.
//
// The pack is spelled inline (rather than via a .func + call) so this
// kernel pins the mma lowering on its own.

.version 8.6
.target sm_80
.address_size 64

.visible .entry mma_s8(
    .param .u64 output
)
{
    .reg .u64       out_addr;
    .reg .u64       out_index;
    .reg .u32       thread_id;
    .reg .u16       in<16>;
    .reg .u32       in32_<4>;
    .reg .u32       p0, p1, p2, p3;
    .reg .b32       a0a1a2a3, a4a5a6a7, a8a9a10a11, a12a13a14a15;
    .reg .b32       b0b1b2b3, b4b5b6b7;
    .reg .b32       d<4>;

    ld.param.u64    out_addr, [output];
    mov.u32         thread_id, %tid.x;

    cvt.u16.u32     in0, thread_id;
    mul.lo.u16      in0, in0, 16;
    add.u16         in1, in0, 1;
    add.u16         in2, in0, 2;
    add.u16         in3, in0, 3;
    add.u16         in4, in0, 4;
    add.u16         in5, in0, 5;
    add.u16         in6, in0, 6;
    add.u16         in7, in0, 7;
    add.u16         in8, in0, 8;
    add.u16         in9, in0, 9;
    add.u16         in10, in0, 10;
    add.u16         in11, in0, 11;
    add.u16         in12, in0, 12;
    add.u16         in13, in0, 13;
    add.u16         in14, in0, 14;
    add.u16         in15, in0, 15;

    // a0a1a2a3 = pack(in0..in3), a4a5a6a7 = pack(in4..in7), ...
    cvt.u32.u16     p0, in0;
    cvt.u32.u16     p1, in1;
    shl.b32         p1, p1, 8;
    cvt.u32.u16     p2, in2;
    shl.b32         p2, p2, 16;
    cvt.u32.u16     p3, in3;
    shl.b32         p3, p3, 24;
    mov.b32         a0a1a2a3, p0;
    or.b32          a0a1a2a3, a0a1a2a3, p1;
    or.b32          a0a1a2a3, a0a1a2a3, p2;
    or.b32          a0a1a2a3, a0a1a2a3, p3;

    cvt.u32.u16     p0, in4;
    cvt.u32.u16     p1, in5;
    shl.b32         p1, p1, 8;
    cvt.u32.u16     p2, in6;
    shl.b32         p2, p2, 16;
    cvt.u32.u16     p3, in7;
    shl.b32         p3, p3, 24;
    mov.b32         a4a5a6a7, p0;
    or.b32          a4a5a6a7, a4a5a6a7, p1;
    or.b32          a4a5a6a7, a4a5a6a7, p2;
    or.b32          a4a5a6a7, a4a5a6a7, p3;

    cvt.u32.u16     p0, in8;
    cvt.u32.u16     p1, in9;
    shl.b32         p1, p1, 8;
    cvt.u32.u16     p2, in10;
    shl.b32         p2, p2, 16;
    cvt.u32.u16     p3, in11;
    shl.b32         p3, p3, 24;
    mov.b32         a8a9a10a11, p0;
    or.b32          a8a9a10a11, a8a9a10a11, p1;
    or.b32          a8a9a10a11, a8a9a10a11, p2;
    or.b32          a8a9a10a11, a8a9a10a11, p3;

    cvt.u32.u16     p0, in12;
    cvt.u32.u16     p1, in13;
    shl.b32         p1, p1, 8;
    cvt.u32.u16     p2, in14;
    shl.b32         p2, p2, 16;
    cvt.u32.u16     p3, in15;
    shl.b32         p3, p3, 24;
    mov.b32         a12a13a14a15, p0;
    or.b32          a12a13a14a15, a12a13a14a15, p1;
    or.b32          a12a13a14a15, a12a13a14a15, p2;
    or.b32          a12a13a14a15, a12a13a14a15, p3;

    // B = two copies of pack(in0..in3)
    mov.b32         b0b1b2b3, a0a1a2a3;
    mov.b32         b4b5b6b7, a0a1a2a3;

    cvt.u32.u16     in32_0, in0;
    cvt.u32.u16     in32_1, in1;
    cvt.u32.u16     in32_2, in2;
    cvt.u32.u16     in32_3, in3;

    mma.sync.aligned.m16n8k32.row.col.s32.s8.s8.s32
        {d0, d1, d2, d3},
        {a0a1a2a3, a4a5a6a7, a8a9a10a11, a12a13a14a15},
        {b0b1b2b3, b4b5b6b7},
        {in32_0, in32_1, in32_2, in32_3};

    cvt.u64.u32     out_index, thread_id;
    mul.lo.u64      out_index, out_index, 16;
    add.u64         out_addr, out_addr, out_index;
    // .b32 accumulators stored through st.f32 moves bits (ptxas-clean).
    st.f32          [out_addr], d0;
    st.f32          [out_addr+4], d1;
    st.f32          [out_addr+8], d2;
    st.f32          [out_addr+12], d3;
    ret;
}