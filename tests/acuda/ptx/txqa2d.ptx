.version 8.6
.target sm_80
.address_size 64
.visible .entry txqa2d(.param .texref tex, .param .u64 out)
{
    .reg .f32 s, t, pad, f0, f1, f2, f3;
    .reg .u32 w, idx;
    .reg .u64 p;
    ld.param.u64 p, [out];
    mov.u32 idx, 1;
    mov.f32 s, 0f3F000000;
    mov.f32 t, 0f3F000000;
    mov.f32 pad, 0f00000000;
    tex.a2d.v4.f32.f32 {f0, f1, f2, f3}, [tex, {idx, s, t, pad}];
    txq.width.b32 w, [tex];
    st.global.u32 [p], w;
    txq.height.b32 w, [tex];
    st.global.u32 [p+4], w;
    txq.depth.b32 w, [tex];
    st.global.u32 [p+8], w;
    txq.array_size.b32 w, [tex];
    st.global.u32 [p+12], w;
    txq.num_mipmap_levels.b32 w, [tex];
    st.global.u32 [p+16], w;
    txq.num_samples.b32 w, [tex];
    st.global.u32 [p+20], w;
    ret;
}
