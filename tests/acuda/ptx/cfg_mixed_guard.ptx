.version 8.6
.target sm_80
.address_size 64
.visible .entry cfg_mixed_guard(.param .u64 io)
{
    .reg .u64 rd;
    .reg .u32 r1, r2, r3;
    .reg .pred p0;
    .reg .pred p1;
    ld.param.u64 rd, [io];
    ld.global.u32 r1, [rd];
    mov.u32 r3, 0;
    mov.u32 r2, %tid.x;
    setp.gt.u32 p1, r2, r1;
    @p1 bra DONE;
HEAD:
    add.u32 r3, r3, 1;
    setp.ge.u32 p0, r3, r1;
    @p0 bra DONE;
    bra.uni HEAD;
DONE:
    st.global.u32 [rd], r3;
    ret;
}
