// 64-bit storage-image atomics and load/store on an R64ui surface
// (SPV_EXT_shader_image_int64).
.version 8.6
.target sm_80
.address_size 64
.visible .entry sured_u64(.param .surfref surf, .param .u64 out)
{
    .reg .u32 %r<3>;
    .reg .u64 %rd<4>;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, 0;
    mov.u32 %r2, 0;

    mov.u64 %rd2, 3;
    sured.b.add.2d.u64.trap [surf, {%r1, %r2}], %rd2;

    mov.u32 %r1, 8;
    mov.u64 %rd2, 7;
    sured.b.min.2d.u64.trap [surf, {%r1, %r2}], %rd2;

    mov.u32 %r1, 16;
    mov.u64 %rd2, 20;
    sured.b.max.2d.u64.trap [surf, {%r1, %r2}], %rd2;

    mov.u32 %r1, 24;
    mov.u64 %rd2, 0x00000000FFFFFFFF;
    sured.b.and.2d.u64.trap [surf, {%r1, %r2}], %rd2;

    mov.u32 %r1, 32;
    mov.u64 %rd2, 0xF0;
    sured.b.or.2d.u64.trap [surf, {%r1, %r2}], %rd2;

    mov.u32 %r1, 0;
    suld.b.2d.b64 %rd3, [surf, {%r1, %r2}];
    mov.u32 %r1, 40;
    sust.b.2d.b64 [surf, {%r1, %r2}], %rd3;

    mov.u32 %r1, 1;
    st.global.u32 [%rd1], %r1;
    ret;
}
