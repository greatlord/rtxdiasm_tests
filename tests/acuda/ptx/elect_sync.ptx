.version 8.8
.target sm_120
.address_size 64
.visible .entry elect_sync(.param .u64 p)
{
    .reg .u64 r, a, off64;
    .reg .u32 lane, leader, bit, off, t;
    .reg .pred p0;
    ld.param.u64 r, [p];
    elect.sync lane|p0, 0xffffffff;
    selp.u32 leader, 1, 0, p0;
    mov.u32 t, %tid.x;
    shl.b32 off, t, 3;
    cvt.u64.u32 off64, off;
    add.u64 a, r, off64;
    st.global.u32 [a], lane;
    st.global.u32 [a+4], leader;
    ret;
}
