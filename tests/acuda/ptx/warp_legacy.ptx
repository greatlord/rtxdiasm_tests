// Deprecated (pre-6.0) shfl/vote spellings, still accepted by ptxas at
// .version 6.0 with warnings. Block size 32: one warp.
.version 6.0
.target sm_70
.address_size 64
.visible .entry warp_legacy(.param .u64 p)
{
    .reg .u64 %rd<4>;
    .reg .u32 %r<8>;
    .reg .pred %q<5>;
    ld.param.u64 %rd1, [p];
    mov.u32 %r1, %tid.x;
    shl.b32 %r2, %r1, 5;
    cvt.u64.u32 %rd2, %r2;
    add.u64 %rd2, %rd1, %rd2;

    shfl.up.b32 %r3|%q1, %r1, 1, 0;
    shfl.down.b32 %r4|%q2, %r1, 1, 31;
    shfl.bfly.b32 %r5|%q3, %r1, 1, 31;
    shfl.idx.b32 %r6|%q4, %r1, 0, 31;
    st.global.u32 [%rd2], %r3;
    st.global.u32 [%rd2+4], %r4;
    st.global.u32 [%rd2+8], %r5;
    st.global.u32 [%rd2+12], %r6;

    setp.lt.u32 %q1, %r1, 16;
    vote.all.pred %q2, %q1;
    vote.any.pred %q3, %q1;
    vote.uni.pred %q4, %q1;
    vote.ballot.b32 %r7, %q1;
    selp.u32 %r3, 1, 0, %q2;
    selp.u32 %r4, 1, 0, %q3;
    selp.u32 %r5, 1, 0, %q4;
    st.global.u32 [%rd2+16], %r3;
    st.global.u32 [%rd2+20], %r4;
    st.global.u32 [%rd2+24], %r5;
    st.global.u32 [%rd2+28], %r7;
    ret;
}
