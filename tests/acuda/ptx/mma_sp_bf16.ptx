// Sparse warp matmul mma.sp.aligned.m16n8k16.row.col.f32.bf16.bf16.f32.
// Same layout and sparse metadata as mma_sp.ptx, but bf16 multiplicands.
//
// Buffer layout (words):
//   0..63    A fragments     (2 words per lane)
//   64..95   metadata        (1 word per lane)
//   96..159  B fragments     (2 words per lane)
//   160..287 C fragments     (4 words per lane)
//   288..415 D fragments     (4 words per lane)

.version 8.5
.target sm_80
.address_size 64

.visible .entry mma_sp_bf16(.param .u64 p)
{
    .reg .u64 %rd, %pa, %off, %zero;
    .reg .u32 %lane;
    .reg .b32 %a<2>, %b<2>, %e;
    .reg .f32 %c<4>, %d<4>;

    ld.param.u64 %rd, [p];
    mov.u32 %lane, %laneid;
    mov.u64 %zero, 0;

    // A fragments
    mad.wide.u32 %off, %lane, 8, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.b32 %a0, [%pa];
    ld.global.b32 %a1, [%pa+4];

    // metadata
    mad.wide.u32 %off, %lane, 4, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.b32 %e, [%pa+256];

    // B fragments
    mad.wide.u32 %off, %lane, 8, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.b32 %b0, [%pa+384];
    ld.global.b32 %b1, [%pa+388];

    // C fragments
    mad.wide.u32 %off, %lane, 16, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.f32 %c0, [%pa+640];
    ld.global.f32 %c1, [%pa+644];
    ld.global.f32 %c2, [%pa+648];
    ld.global.f32 %c3, [%pa+652];

    mma.sp::ordered_metadata.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32
        {%d0,%d1,%d2,%d3}, {%a0,%a1}, {%b0,%b1},
        {%c0,%c1,%c2,%c3}, %e, 0;

    st.global.f32 [%pa+1152], %d0;
    st.global.f32 [%pa+1156], %d1;
    st.global.f32 [%pa+1160], %d2;
    st.global.f32 [%pa+1164], %d3;
    ret;
}
