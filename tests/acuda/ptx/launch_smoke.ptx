.version 8.6
.target sm_80
.address_size 64
// Small launch-cache smoke kernel: out[i] = in[i] + inc.
.visible .entry smoke_add(
    .param .u64 out,
    .param .u64 in,
    .param .u32 n,
    .param .u32 inc
)
{
    .reg .pred %p<2>;
    .reg .u32 %r<10>;
    .reg .u64 %rd<6>;

    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r3, %r2, %r1;
    ld.param.u32 %r5, [n];
    setp.ge.u32 %p1, %r4, %r5;
    @%p1 bra.uni done;

    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [in];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    ld.param.u32 %r6, [inc];
    mul.wide.u32 %rd3, %r4, 4;
    add.u64 %rd1, %rd1, %rd3;
    add.u64 %rd2, %rd2, %rd3;
    ld.global.u32 %r7, [%rd2];
    add.u32 %r8, %r7, %r6;
    st.global.u32 [%rd1], %r8;

done:
    ret;
}

// Regression: signed packed saturating byte subtraction. The source
// words live at +16/+20; the result is written at +0.
.visible .entry smoke_sat(.param .u64 p)
{
    .reg .u64 %rd;
    .reg .u32 %a, %b, %d;
    ld.param.u64 %rd, [p];
    ld.global.b32 %a, [%rd+16];
    ld.global.b32 %b, [%rd+20];
    sub.sat.s8x4 %d, %a, %b;
    st.global.b32 [%rd], %d;
    ret;
}
