.version 8.6
.target sm_80
.address_size 64
.shared .align 4 .b8 s[16];
.visible .entry ldst_shared_cta(.param .u64 p)
{
    .reg .u64 a;
    .reg .u32 r;
    ld.param.u64 a, [p];
    mov.u32 r, 0x1234;
    st.shared::cta.u32 [s], r;
    ld.shared::cta.u32 r, [s];
    st.global.u32 [a+4], r;
    ret;
}
