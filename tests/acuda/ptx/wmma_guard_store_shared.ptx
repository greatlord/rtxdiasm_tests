// WMMA shared A/B loads plus a shared WMMA store: the typed 16-bit
// shared view must stay off.
.version 8.0
.target sm_80
.address_size 64

.visible .entry wmma_guard_store_shared()
{
    .reg .u32 %stride, %sa;
    .reg .b32 %a<8>, %b<8>, %c<8>;

    .shared .align 16 .b8 s[1024];

    mov.u32 %stride, 16;
    mov.u32 %sa, s;
    wmma.load.a.sync.aligned.m16n16k16.shared.row.f16
        {%a0,%a1,%a2,%a3,%a4,%a5,%a6,%a7}, [%sa], %stride;
    wmma.load.b.sync.aligned.m16n16k16.shared.col.f16
        {%b0,%b1,%b2,%b3,%b4,%b5,%b6,%b7}, [%sa+512], %stride;
    mov.b32 %c0, 0;
    mov.b32 %c1, 0;
    mov.b32 %c2, 0;
    mov.b32 %c3, 0;
    mov.b32 %c4, 0;
    mov.b32 %c5, 0;
    mov.b32 %c6, 0;
    mov.b32 %c7, 0;
    wmma.store.d.sync.aligned.m16n16k16.shared.row.f32
        [%sa], {%c0,%c1,%c2,%c3,%c4,%c5,%c6,%c7}, %stride;
    ret;
}
