// A normal shared WMMA load plus a non-16x16 shared WMMA load: the typed
// 16-bit shared view must stay off because the second layout is not the
// one the typed view was validated for.
.version 8.0
.target sm_80
.address_size 64

.visible .entry wmma_guard_shape()
{
    .reg .u32 %stride, %sa;
    .reg .b32 %a<8>, %b<8>;

    .shared .align 16 .b8 s[1024];

    mov.u32 %stride, 16;
    mov.u32 %sa, s;
    wmma.load.a.sync.aligned.m16n16k16.shared.row.f16
        {%a0,%a1,%a2,%a3,%a4,%a5,%a6,%a7}, [%sa], %stride;
    wmma.load.a.sync.aligned.m8n32k16.shared.row.f16
        {%b0,%b1,%b2,%b3,%b4,%b5,%b6,%b7}, [%sa], %stride;
    ret;
}
