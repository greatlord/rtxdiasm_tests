// Dense warp matmul mma.sync.aligned.m16n8k8.row.col.f64.f64.f64.f64.
// Requires sm_90 or higher (target-gated). Per-lane fragments: A 4,
// B 2, C/D 4 .f64 registers.

.version 8.0
.target sm_90
.address_size 64

.visible .entry mma_f64_k8(.param .u64 p)
{
    .reg .u64 %rd, %pa, %off, %zero;
    .reg .u32 %lane;
    .reg .f64 %a<4>, %b<2>, %c<4>, %d<4>;

    ld.param.u64 %rd, [p];
    mov.u32 %lane, %laneid;
    mov.u64 %zero, 0;

    mad.wide.u32 %off, %lane, 32, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.f64 %a0, [%pa+0];
    ld.global.f64 %a1, [%pa+8];
    ld.global.f64 %a2, [%pa+16];
    ld.global.f64 %a3, [%pa+24];
    mad.wide.u32 %off, %lane, 16, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.f64 %b0, [%pa+1024];
    ld.global.f64 %b1, [%pa+1032];
    mad.wide.u32 %off, %lane, 32, %zero;
    add.u64 %pa, %rd, %off;
    ld.global.f64 %c0, [%pa+1536];
    ld.global.f64 %c1, [%pa+1544];
    ld.global.f64 %c2, [%pa+1552];
    ld.global.f64 %c3, [%pa+1560];
    mma.sync.aligned.m16n8k8.row.col.f64.f64.f64.f64
        {%d0,%d1,%d2,%d3}, {%a0,%a1,%a2,%a3}, {%b0,%b1},
        {%c0,%c1,%c2,%c3};

    st.global.f64 [%pa+2560], %d0;
    st.global.f64 [%pa+2568], %d1;
    st.global.f64 [%pa+2576], %d2;
    st.global.f64 [%pa+2584], %d3;
    ret;
}
