.version 8.0
.target sm_86
.address_size 64
.visible .entry misc(.param .u64 p)
{
    .reg .u64 %rd, %addr;
    .reg .u32 %a, %b, %c, %d, %r;
    .reg .b32 %x;
    .reg .f32 %f1, %f2, %f3;
    .reg .pred %q;
    ld.param.u64 %rd, [p];
    cnot.b32 %d, 0;
    st.global.u32 [%rd+0], %d;
    cnot.b32 %d, 5;
    st.global.u32 [%rd+4], %d;
    mov.u32 %a, 0xF0F0F0F0;
    mov.u32 %b, 0xCCCCCCCC;
    mov.u32 %c, 0xAAAAAAAA;
    lop3.b32 %d, %a, %b, %c, 0xEA;
    st.global.u32 [%rd+8], %d;
    mov.u32 %a, 0x11111111;
    mov.u32 %b, 0x22222222;
    mov.s32 %c, 5;
    slct.b32.s32 %d, %a, %b, %c;
    st.global.u32 [%rd+12], %d;
    mov.s32 %c, -1;
    slct.b32.s32 %d, %a, %b, %c;
    st.global.u32 [%rd+16], %d;
    mov.f32 %f1, 0F3f800000;
    mov.f32 %f2, 0Fbf800000;
    mov.f32 %f3, 0F00000000;
    slct.b32.f32 %d, %a, %b, %f3;
    st.global.u32 [%rd+20], %d;
    mov.f32 %f3, 0Fbf800000;
    slct.b32.f32 %d, %a, %b, %f3;
    st.global.u32 [%rd+24], %d;
    ldu.global.b32 %d, [%rd+80];
    st.global.u32 [%rd+28], %d;
    prefetch.global.L1 [%rd+80];
    prefetchu.L1 [%rd+80];
    applypriority.global.L2::evict_normal [%rd+80], 128;
    discard.global.L2 [%rd+80], 128;
    bar.warp.sync 0xffffffff;
    red.global.add.u32 [%rd+80], 5;
    ld.global.u32 %r, [%rd+80];
    st.global.u32 [%rd+32], %r;
    red.global.max.s32 [%rd+84], 0x1234;
    ld.global.u32 %r, [%rd+84];
    st.global.u32 [%rd+36], %r;
    ret;
}
