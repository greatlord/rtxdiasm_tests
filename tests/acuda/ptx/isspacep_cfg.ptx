.version 8.6
.target sm_80
.address_size 64
.const .u32 cvar[1] = { 11 };
.visible .entry isspacep_cfg(.param .u64 io)
{
    .reg .u64 rd, cp;
    .reg .u32 r1, r2;
    .reg .pred p0, p1;
    ld.param.u64 rd, [io];
    ld.global.u32 r1, [rd];
    mov.u64 cp, cvar;
    mov.u32 r2, 0;
    setp.eq.u32 p0, r1, 1;
    @p0 bra LOOP;
    add.u32 r2, r2, 10;
LOOP:
    add.u32 r2, r2, 1;
    isspacep.const p1, cp;
    selp.u32 r2, r2, 99, p1;
    setp.lt.u32 p0, r2, 5;
    @p0 bra LOOP;
    st.global.u32 [rd], r2;
    ret;
}
