.version 8.8
.target sm_90
.address_size 64
.visible .entry half_fp(.param .u64 p)
{
    .reg .u64 %rd1;
    .reg .b16 %d, %a, %b, %c, %neg15, %sub, %zero, %nan;
    .reg .b32 %pd, %pa, %pb, %pc, %pneg, %psub, %ptwo, %pzero, %pnan;
    ld.param.u64 %rd1, [p];
    ld.global.b16 %a, [%rd1+0];
    ld.global.b16 %b, [%rd1+2];
    ld.global.b16 %c, [%rd1+4];
    ld.global.b16 %neg15, [%rd1+6];
