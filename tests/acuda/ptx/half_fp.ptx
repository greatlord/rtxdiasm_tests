    ld.global.b32 %pb, [%rd1+16];
    ld.global.b32 %pc, [%rd1+20];
    ld.global.b32 %pneg, [%rd1+24];
    ld.global.b32 %psub, [%rd1+28];
    ld.global.b32 %ptwo, [%rd1+32];
    ld.global.b32 %pzero, [%rd1+36];
    ld.global.b32 %pnan, [%rd1+40];
    add.f16 %d, %a, %b;
    st.global.b16 [%rd1+48], %d;
    sub.f16 %d, %b, %a;
    st.global.b16 [%rd1+52], %d;
    mul.f16 %d, %a, %b;
    st.global.b16 [%rd1+56], %d;
    fma.rn.f16 %d, %a, %b, %c;
    st.global.b16 [%rd1+60], %d;
    add.sat.f16 %d, %a, %b;
    st.global.b16 [%rd1+64], %d;
    add.ftz.f16 %d, %sub, %a;
    st.global.b16 [%rd1+68], %d;
    neg.f16 %d, %neg15;
    st.global.b16 [%rd1+72], %d;
    abs.f16 %d, %neg15;
    st.global.b16 [%rd1+76], %d;
    abs.ftz.f16 %d, %sub;
    st.global.b16 [%rd1+80], %d;
    min.f16 %d, %a, %b;
    st.global.b16 [%rd1+84], %d;
    max.f16 %d, %a, %b;
    st.global.b16 [%rd1+88], %d;
    min.NaN.f16 %d, %a, %nan;
    st.global.b16 [%rd1+92], %d;
    min.ftz.f16 %d, %sub, %a;
    st.global.b16 [%rd1+96], %d;
    tanh.approx.f16 %d, %zero;
    st.global.b16 [%rd1+100], %d;
    ex2.approx.f16 %d, %b;
    st.global.b16 [%rd1+104], %d;
    add.f16x2 %pd, %pa, %pb;
    st.global.u32 [%rd1+108], %pd;
    sub.f16x2 %pd, %pa, %pb;
    st.global.u32 [%rd1+112], %pd;
    mul.f16x2 %pd, %pa, %pb;
    st.global.u32 [%rd1+116], %pd;
    fma.rn.f16x2 %pd, %pa, %pb, %pc;
    st.global.u32 [%rd1+120], %pd;
    add.sat.f16x2 %pd, %pa, %pb;
    st.global.u32 [%rd1+124], %pd;
    add.ftz.f16x2 %pd, %psub, %ptwo;
    st.global.u32 [%rd1+128], %pd;
    neg.f16x2 %pd, %pneg;
    st.global.u32 [%rd1+132], %pd;
    abs.f16x2 %pd, %pneg;
    st.global.u32 [%rd1+136], %pd;
    min.f16x2 %pd, %pa, %pb;
    st.global.u32 [%rd1+140], %pd;
    max.f16x2 %pd, %pa, %pb;
    st.global.u32 [%rd1+144], %pd;
    min.NaN.f16x2 %pd, %pa, %pnan;
    st.global.u32 [%rd1+148], %pd;
    tanh.approx.f16x2 %pd, %pzero;
    st.global.u32 [%rd1+152], %pd;
    ex2.approx.f16x2 %pd, %pa;
    st.global.u32 [%rd1+156], %pd;
    ret;
}
