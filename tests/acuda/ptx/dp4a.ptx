.version 8.8
.target sm_120
.address_size 64
.visible .entry dp4a(.param .u64 p)
{
    .reg .u64 r;
    .reg .u32 d, a, b;
    ld.param.u64 r, [p];
    // u8 x u8
    mov.u32 a, 0x01020304;
    mov.u32 b, 0x05060708;
    dp4a.u32.u32 d, a, b, 100;
    st.global.u32 [r], d;
    // s8 x s8
    mov.u32 a, 0xfffffffe;
    mov.u32 b, 2;
    dp4a.s32.s32 d, a, b, 1;
    st.global.u32 [r+4], d;
    // s8 x u8
    mov.u32 a, 0xfffffffe;
    mov.u32 b, 3;
    dp4a.s32.u32 d, a, b, 10;
    st.global.u32 [r+8], d;
    // u8 x s8
    mov.u32 a, 2;
    mov.u32 b, 0xfffffffe;
    dp4a.u32.s32 d, a, b, 10;
    st.global.u32 [r+12], d;
    // dp2a stays on the exact multiply-add expansion
    mov.u32 a, 0x00020003;
    mov.u32 b, 4;
    dp2a.lo.u32.u32 d, a, b, 8;
    st.global.u32 [r+16], d;
    mov.u32 a, 0x00020003;
    mov.u32 b, 0x00050004;
    dp2a.hi.u32.u32 d, a, b, 0;
    st.global.u32 [r+20], d;
    mov.u32 a, 0xfffffffd;
    mov.u32 b, 2;
    dp2a.lo.s32.s32 d, a, b, 10;
    st.global.u32 [r+24], d;
    ret;
}
