.version 7.0
.target sm_80
.address_size 64

.visible .entry loop_continue(.param .u64 p)
{
    .reg .u64 rd;
    .reg .u32 i, s;
    .reg .pred done, skip;

    ld.param.u64 rd, [p];
    mov.u32 i, 0;
    mov.u32 s, 0;
LOOP:
    setp.ge.u32 done, i, 10;
    @done bra EXIT;
    setp.eq.u32 skip, i, 3;
    @skip bra CONT;
    add.u32 s, s, i;
CONT:
    add.u32 i, i, 1;
    bra LOOP;
EXIT:
    st.global.u32 [rd], s;
    ret;
}
