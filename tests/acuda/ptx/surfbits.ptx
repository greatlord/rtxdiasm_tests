.version 8.6
.target sm_80
.address_size 64
.visible .entry surfbits(.param .surfref surf, .param .u64 out)
{
    .reg .u32 r0, r1, r2;
    .reg .u64 r64;
    .reg .s32 x, y;
    .reg .u64 p;
    ld.param.u64 p, [out];
    mov.s32 x, 1;
    mov.s32 y, 0;
    suld.b.2d.b8.trap r0, [surf, {x, y}];
    st.global.u32 [p], r0;
    mov.s32 x, 2;
    suld.b.2d.b16.trap r1, [surf, {x, y}];
    st.global.u32 [p+4], r1;
    mov.s32 x, 0;
    suld.b.2d.b64.trap r64, [surf, {x, y}];
    st.global.u64 [p+8], r64;
    mov.s32 x, 8;
    mov.u32 r2, 0x00001111;
    sust.b.2d.b16.trap [surf, {x, y}], r2;
    mov.s32 x, 12;
    mov.u32 r2, 0xF0F0;
    sured.b.and.2d.b32.trap [surf, {x, y}], r2;
    ret;
}
