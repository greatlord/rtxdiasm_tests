.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u32 value;
    .reg .u32 shuffled;
    .reg .u32 active;
    .reg .u32 tid;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.u32 value, [in_addr];
    mov.u32 tid, %tid.x;
    add.u32 value, value, tid;
    activemask.b32 active;
    shfl.sync.up.b32 shuffled, value, 1, 0x1f, active;
    st.global.u32 [out_addr], shuffled;
    ret;
}
