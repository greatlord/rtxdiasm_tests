.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .f32 a;
    .reg .f32 b;
    .reg .f32 lo;
    .reg .f32 hi;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.f32 a, [in_addr];
    ld.global.f32 b, [in_addr+4];
    min.f32 lo, a, b;
    max.f32 hi, a, b;
    st.global.f32 [out_addr], lo;
    st.global.f32 [out_addr+4], hi;
    ret;
}
