.version 6.2
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u32 value;
    .reg .u32 mask;
    .reg .u32 active;
    .reg .pred nonzero;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.u32 value, [in_addr];
    setp.ne.u32 nonzero, value, 0;
    activemask.b32 active;
    vote.sync.ballot.b32 mask, nonzero, active;
    st.global.u32 [out_addr], mask;
    ret;
}
