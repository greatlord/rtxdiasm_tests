.version 6.0
.target sm_50
.address_size 64

.visible .entry cfg_sm_bar_diverge(
    .param .u64 out_ptr
)
{
    .reg .pred %p<4>;
    .reg .u32 %r<12>;
    .reg .u64 %rd<4>;

    ld.param.u64 %rd1, [out_ptr];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, 0;
    mov.u32 %r2, %r0;

LOOP:
    setp.lt.u32 %p1, %r1, 4;
    @!%p1 bra DONE;

    // Data-dependent divergence within the loop.
    and.b32 %r3, %r2, 1;
    setp.eq.u32 %p2, %r3, 0;
    @%p2 bra EVEN;

ODD:
    add.u32 %r4, %r2, %r1;
    mad.lo.u32 %r2, %r4, 3, 1;
    setp.lt.u32 %p3, %r2, 100;
    @%p3 bra MERGE;
    sub.u32 %r2, %r2, 7;
    bra MERGE;

EVEN:
    add.u32 %r5, %r2, %r0;
    mad.lo.u32 %r2, %r5, 5, 2;
    setp.ge.u32 %p3, %r2, 50;
    @%p3 bra MERGE;
    add.u32 %r2, %r2, 9;

MERGE:
    // Block-wide barrier reached by all threads each iteration.
    bar.sync 0;
    add.u32 %r1, %r1, 1;
    // Extra conditional backedge structure to keep CFG non-trivial.
    setp.lt.u32 %p1, %r1, 4;
    @%p1 bra LOOP;

DONE:
    mul.wide.u32 %rd2, %r0, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r2;
    ret;
}
