.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .f32 value;
    .reg .u32 result;
    .reg .pred predicate;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.f32 value, [in_addr];
    setp.geu.f32 predicate, value, 1.0;
    selp.u32 result, 1, 0, predicate;
    st.global.u32 [out_addr], result;
    ret;
}
