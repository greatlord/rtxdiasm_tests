.version 6.1
.target sm_50
.address_size 64
.visible .entry k(.param .u64 p, .param .u32 n)
{
 .reg .u64 %rd<4>;
 .reg .u32 %r<20>;
 .reg .pred %p<2>;
 ld.param.u64 %rd1, [p];
 ld.param.u32 %r1, [n];
 ld.global.u32 %r2, [%rd1];
 add.s32 %r3, %r2, %r1;
 sub.s32 %r4, %r3, 3;
 mul.lo.s32 %r5, %r4, %r3;
 mad.lo.s32 %r6, %r5, 5, %r4;
 and.b32 %r7, %r6, 255;
 or.b32 %r8, %r7, %r1;
 xor.b32 %r9, %r8, %r6;
 shl.b32 %r10, %r9, 2;
 shr.u32 %r11, %r10, 1;
 setp.gt.s32 %p1, %r11, 10;
 @%p1 add.s32 %r12, %r11, 1;
 @!%p1 sub.s32 %r12, %r11, 1;
 selp.u32 %r13, %r12, %r11, %p1;
 st.global.u32 [%rd1], %r13;
 ret;
}
