.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .f64 value;
    .reg .f64 result;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.f64 value, [in_addr];
    add.f64 result, value, 3.25;
    st.global.f64 [out_addr], result;
    ret;
}
