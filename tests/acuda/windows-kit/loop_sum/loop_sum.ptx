.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 output
)
{
    .reg .u64 out_addr;
    .reg .u32 i;
    .reg .u32 sum;
    .reg .pred done;

    ld.param.u64 out_addr, [output];
    mov.u32 i, 0;
    mov.u32 sum, 0;
L:
    setp.ge.u32 done, i, 10;
    @done bra L_done;
    add.u32 sum, sum, i;
    add.u32 i, i, 1;
    bra L;
L_done:
    st.global.u32 [out_addr], sum;
    ret;
}
