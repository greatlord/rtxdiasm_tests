.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .b64 in_ptr;
    .reg .b64 out_ptr;
    .reg .b32 hi;
    .reg .b32 value;
    .reg .pred nonzero;

    ld.param.u64 in_ptr, [input];
    cvta.to.global.u64 in_ptr, in_ptr;
    ld.param.u64 out_ptr, [output];
    cvta.to.global.u64 out_ptr, out_ptr;
    ld.param.u32 hi, [input+4];
    ld.global.u32 value, [in_ptr];
    setp.ne.u32 nonzero, hi, 0;
    @nonzero st.global.u32 [out_ptr], value;
    ret;
}
