.version 6.0
.target sm_30
.address_size 64

.visible .entry bfind_u32(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u32 value;
    .reg .u32 result;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.u32 value, [in_addr];
    bfind.u32 result, value;
    st.global.u32 [out_addr], result;
    ret;
}
