.version 6.0
.target sm_50
.address_size 64

.visible .entry k(.param .u32 x, .param .u64 out)
{
    .reg .u32 r0, r1;
    .reg .u64 p;
    .reg .pred p0;
    ld.param.u32 r0, [x];
    ld.param.u64 p, [out];
    mov.u32 r1, 0;
    setp.lt.u32 p0, r0, 10;
    @p0 bra L1;
    add.u32 r1, r0, 100;
    bra L2;
L1:
    add.u32 r1, r0, 1;
L2:
    st.global.u32 [p], r1;
    ret;
}
