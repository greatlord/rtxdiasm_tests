.version 6.0
.target sm_50
.address_size 64

.visible .entry k(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u32 a;
    .reg .u32 b;
    .reg .u32 c;
    .reg .u32 result;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];

    ld.global.u32 a, [in_addr];
    ld.global.u32 b, [in_addr+4];
    ld.global.u32 c, [in_addr+8];
    shf.r.wrap.b32 result, a, b, c;
    st.global.u32 [out_addr], result;
    ret;
}
